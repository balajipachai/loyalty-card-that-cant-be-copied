# --- Client-side (exposed to the browser, safe to be public) ---
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Server-side only (never exposed to the browser) ---
# Privy Dashboard -> App settings -> Basics -> App secret
PRIVY_APP_SECRET=

# Public or your own RPC endpoint for Base Sepolia (chain id 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployed LoyaltyCard contract address (see contracts/README.md to deploy)
LOYALTY_CARD_ADDRESS=

# Private key of the backend signer wallet - the LoyaltyCard contract's
# owner, and the ONLY account allowed to call awardStamp(). Fund it with a
# small amount of Base Sepolia ETH for gas, nothing else. Never commit this.
BACKEND_WALLET_PRIVATE_KEY=
